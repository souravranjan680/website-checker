// =============================================================================
// Database schema: the single source of truth for every table.
//
// After changing this file:
//   npm run db:migrate -- --name describe_your_change   (creates + applies SQL)
//   npm run db:generate                                  (refreshes the TS client)
//
// Design notes: docs/03-database.md
// =============================================================================

// Generates a fully typed TypeScript client into src/generated/prisma.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  USER
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ScanMode {
  SINGLE_PAGE
  URL_LIST
  CRAWL
}

enum ScanTrigger {
  MANUAL
  RESCAN
  SCHEDULED
  API
}

enum ScanStatus {
  QUEUED
  RUNNING
  CANCELLING
  CANCELLED
  COMPLETED
  PARTIAL // finished, but some pages or stages failed
  FAILED
}

enum PageStatus {
  PENDING
  SCANNING
  DONE
  FAILED
  SKIPPED
}

enum IssueCategory {
  ACCESSIBILITY
  UI_HEALTH
  RESPONSIVE
  PERFORMANCE
  SEO
  SECURITY
  FUNCTIONAL // interaction and navigation checks (Phase 9)
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum IssueStatus {
  OPEN
  RESOLVED
  IGNORED
  FALSE_POSITIVE
}

/// How strong the evidence for an automated finding is (Phase 9). Shared by the
/// health scan and the website comparison. Human decisions live in ReviewStatus.
enum FindingClassification {
  DETECTED // a deterministic rule failed, with objective evidence (e.g. axe violation, confirmed 404)
  POTENTIAL_DEFECT // heuristic evidence suggests something is broken (e.g. covered control)
  OBSERVATION // a fact or difference worth reviewing, no evidence of breakage
  INCONCLUSIVE // could not be verified, or needs a human to decide (e.g. axe "needs review")
}

/// A person's verdict on a tracked problem (Phase 9). Separate from the lifecycle
/// status (OPEN/RESOLVED/IGNORED/FALSE_POSITIVE): a CONFIRMED issue can still be RESOLVED later.
enum ReviewStatus {
  UNREVIEWED
  CONFIRMED // confirmed defect
  INTENTIONAL // works as designed
}

/// Interaction and navigation checks of the safe explorer (Phase 9, Milestone 1).
enum FunctionalCheckType {
  CONTROL_NO_EFFECT // a menu/disclosure/tab control changed nothing visible
  LAYER_CLIPPED // an opened menu or panel is cut off
  LAYER_OCCLUDED // items of an opened layer are hidden behind other content
  LAYER_BLANK_AREA // an opened layer has a large empty area
  LAYER_NOT_DISMISSIBLE // an opened menu cannot be closed
  ESCAPE_NOT_SUPPORTED // an opened menu does not close with Escape
  TAB_PANEL_NOT_SHOWN // a selected tab does not show its panel
  INTERACTION_ERROR // a JavaScript error was thrown while interacting
  BROKEN_ANCHOR // an in-page link points to a section that does not exist
  NAV_CURRENT_MISMATCH // navigation marks a different page as the current one
}

enum DetectionType {
  AUTOMATED // axe "violations": confirmed failures
  NEEDS_REVIEW // axe "incomplete": a human must decide
}

enum UiCheckType {
  BROKEN_IMAGE
  BROKEN_LINK
  HORIZONTAL_SCROLL
  CONTENT_OVERFLOW
  OVERLAPPING_ELEMENTS
  TEXT_CLIPPING
  OUT_OF_VIEWPORT
  FAILED_STYLESHEET
  FAILED_SCRIPT
  CONSOLE_ERROR
  JS_ERROR
  FAILED_REQUEST
  EMPTY_BUTTON
  EMPTY_LINK
  BROKEN_NAVIGATION
  IMAGE_SIZING
}

enum SeoCheckType {
  MISSING_TITLE
  DUPLICATE_TITLE
  MISSING_META_DESCRIPTION
  DUPLICATE_META_DESCRIPTION
  MISSING_H1
  MULTIPLE_H1
  MISSING_CANONICAL
  MISSING_OPEN_GRAPH
  BROKEN_INTERNAL_LINK
  MISSING_IMAGE_ALT
  MISSING_SITEMAP
  MISSING_ROBOTS_TXT
  NOINDEX
  TITLE_LENGTH
  META_DESCRIPTION_LENGTH
  INVALID_CANONICAL
  SKIPPED_HEADING_LEVEL
  ROBOTS_BLOCKS_ALL
}

enum SecurityCheckType {
  NO_HTTPS
  HTTP_NOT_REDIRECTED
  MIXED_CONTENT
  MISSING_CSP
  MISSING_X_CONTENT_TYPE_OPTIONS
  MISSING_REFERRER_POLICY
  MISSING_FRAME_PROTECTION
  MISSING_HSTS
  INSECURE_COOKIE
  INVALID_CERTIFICATE
  CERTIFICATE_EXPIRING
  INSECURE_FORM
  WEAK_CSP
  VERSION_DISCLOSURE
}

/// How sure we are, for security findings (passive checks only, never exploits):
/// OBSERVATION = worth knowing, often fine; WARNING = a recommended protection is missing;
/// CONFIRMED = an insecure configuration we directly observed (not a tested exploit).
enum NotificationEmailStatus {
  NOT_REQUESTED
  PENDING
  SENT
  FAILED
}

enum VisualComparisonStatus {
  UNCHANGED
  MINOR
  CHANGED
}

enum SecurityFindingLevel {
  OBSERVATION
  WARNING
  CONFIRMED
}

enum FormFactor {
  DESKTOP
  MOBILE
}

enum ScreenshotKind {
  PAGE_FULL
  VIEWPORT
  ISSUE_CROP
  BASELINE
  VISUAL_CURRENT
  VISUAL_DIFF
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum BugReportStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum AiInsightKind {
  EXPLANATION
  FIX
  BUG_REPORT
}

enum NotificationType {
  SCAN_COMPLETED
  SCAN_FAILED
  REGRESSION_DETECTED
  SYSTEM
}

// ----------------------------------------------------------------------------
// Users & authentication
// ----------------------------------------------------------------------------

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique // stored lower-cased by the API
  passwordHash            String
  name                    String
  role                    UserRole  @default(USER)
  isActive                Boolean   @default(true)
  lastLoginAt             DateTime?
  /// Which notifications the user wants (merged with defaults by the API).
  notificationPreferences Json      @default("{}")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  apiTokens           ApiToken[]
  memberships         ProjectMember[]
  createdProjects     Project[]            @relation("ProjectCreatedBy")
  createdWebsites     Website[]            @relation("WebsiteCreatedBy")
  triggeredScans      Scan[]               @relation("ScanTriggeredBy")
  visualBaselines     VisualBaseline[]
  bugReports          BugReport[]
  aiInsights          AiInsight[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  issueReviews        IssueReview[]
  reviewedIssues      TrackedIssue[]       @relation("TrackedIssueReviewedBy")
}

/// One row per login session. Only a SHA-256 hash of the token is stored.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String // all rotations of one login share a family (reuse detection)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Personal access tokens (used by the Chrome extension and CI scripts).
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String // first characters, shown in the UI so users can tell tokens apart
  tokenHash  String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Projects & websites
// ----------------------------------------------------------------------------

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User?           @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  websites     Website[]
  bugReports   BugReport[]
  activityLogs ActivityLog[]

  @@index([createdById])
}

/// Role-based access control is enforced per project through this table.
model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Website {
  id                       String             @id @default(cuid())
  projectId                String
  name                     String
  baseUrl                  String // normalized, e.g. https://example.com/
  hostname                 String
  maxDepth                 Int                @default(2)
  maxPages                 Int                @default(20)
  includePatterns          String[]           @default([])
  excludePatterns          String[]           @default([])
  respectRobotsTxt         Boolean            @default(true)
  responsivePageLimit      Int                @default(3)
  lighthousePageLimit      Int                @default(1)
  /// Safe explorer (Phase 9): opens menus, tabs and expandable sections on the first pages.
  explorationEnabled       Boolean            @default(true)
  explorationPageLimit     Int                @default(5)
  explorationControlLimit  Int                @default(30)
  verificationStatus       VerificationStatus @default(UNVERIFIED)
  verificationToken        String?            @unique
  verifiedAt               DateTime?
  authorizationConfirmedAt DateTime // "I own or am authorized to test this site"
  createdById              String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("WebsiteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  schedule        ScanSchedule?
  scans           Scan[]
  trackedIssues   TrackedIssue[]
  visualBaselines VisualBaseline[]
  bugReports      BugReport[]

  @@unique([projectId, baseUrl])
  @@index([hostname])
}

model ScanSchedule {
  id             String    @id @default(cuid())
  websiteId      String    @unique
  cronExpression String
  timezone       String    @default("UTC")
  isEnabled      Boolean   @default(true)
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// Scans
// ----------------------------------------------------------------------------

model Scan {
  id                 String      @id @default(cuid())
  websiteId          String
  triggeredById      String?
  trigger            ScanTrigger @default(MANUAL)
  mode               ScanMode    @default(CRAWL)
  status             ScanStatus  @default(QUEUED)
  config             Json // snapshot of website settings + overrides at scan time
  jobId              String? // BullMQ job id
  progress           Int         @default(0) // 0..100
  currentStep        String?
  pagesDiscovered    Int         @default(0)
  pagesScanned       Int         @default(0)
  pagesFailed        Int         @default(0)
  errorMessage       String?
  // Scores are written once when the scan finishes (null = not measured).
  accessibilityScore Int?
  uiHealthScore      Int?
  performanceScore   Int?
  seoScore           Int?
  bestPracticesScore Int?
  securityScore      Int?
  // Denormalized counts so list pages and the dashboard stay fast.
  totalIssues        Int         @default(0)
  criticalCount      Int         @default(0)
  highCount          Int         @default(0)
  mediumCount        Int         @default(0)
  lowCount           Int         @default(0)
  infoCount          Int         @default(0)
  manualChecklist    Json? // state of the manual accessibility checklist
  siteChecks         Json? // site-level audit facts: robots.txt, sitemap, TLS, HTTP redirect (Phase 6)
  browserVersion     String? // e.g. "Chromium 140.0.7339.16", for bug reports (Phase 6)
  previousScanId     String? // the scan this one is compared against
  queuedAt           DateTime    @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  durationMs         Int?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  website            Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  triggeredBy        User?               @relation("ScanTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  previousScan       Scan?               @relation("ScanComparison", fields: [previousScanId], references: [id], onDelete: SetNull)
  nextScans          Scan[]              @relation("ScanComparison")
  pages              ScanPage[]
  issues             Issue[]
  performanceResults PerformanceResult[]
  screenshots        Screenshot[]
  visualComparisons  VisualComparison[]
  firstSeenTracked   TrackedIssue[]      @relation("TrackedFirstSeen")
  lastSeenTracked    TrackedIssue[]      @relation("TrackedLastSeen")
  resolvedTracked    TrackedIssue[]      @relation("TrackedResolvedIn")

  @@index([websiteId, createdAt(sort: Desc)])
  @@index([status])
  @@index([triggeredById])
  @@index([createdAt]) // dashboard: scans in a date range
}

model ScanPage {
  id              String     @id @default(cuid())
  scanId          String
  url             String
  normalizedUrl   String
  depth           Int        @default(0)
  status          PageStatus @default(PENDING)
  httpStatus      Int?
  contentType     String?
  title           String?
  metaDescription String?
  canonicalUrl    String?
  language        String?
  h1Count         Int?
  loadTimeMs      Int?
  responseHeaders Json?
  consoleErrors   Json?
  failedRequests  Json?
  pageErrors      Json? // uncaught JavaScript exceptions
  seoData         Json? // meta robots, Open Graph, heading outline, images without alt (Phase 6)
  /// Safe explorer summary (Phase 9): controls explored, skipped (with reasons), blocked actions.
  exploration     Json?
  errorMessage    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  scan               Scan                @relation(fields: [scanId], references: [id], onDelete: Cascade)
  issues             Issue[]
  performanceResults PerformanceResult[]
  screenshots        Screenshot[]

  @@unique([scanId, normalizedUrl])
  @@index([scanId, status])
}

// ----------------------------------------------------------------------------
// Issues: one base table + one detail table per category
// ----------------------------------------------------------------------------

/// Every finding of every category. Category-specific fields live in the
/// 1:1 detail tables below (AccessibilityIssue, UIHealthIssue, ...).
model Issue {
  id             String                @id @default(cuid())
  scanId         String
  scanPageId     String? // null for site-level findings (e.g. missing sitemap.xml)
  trackedIssueId String?
  category       IssueCategory
  severity       Severity
  ruleId         String // e.g. "image-alt", "ui/horizontal-scroll", "sec/missing-csp"
  title          String
  description    String
  pageUrl        String?
  viewport       String? // e.g. "390x844"
  selector       String?
  htmlSnippet    String? // truncated; always rendered as text, never as HTML
  boundingBox    Json? // { x, y, width, height } in page coordinates
  suggestedFix   String?
  details        Json?
  fingerprint    String // stable id of "the same problem" across scans
  screenshotId   String?
  /// Set by the scanner for every new issue; older rows were backfilled by the migration.
  classification FindingClassification @default(INCONCLUSIVE)
  createdAt      DateTime              @default(now())

  scan          Scan                @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanPage      ScanPage?           @relation(fields: [scanPageId], references: [id], onDelete: Cascade)
  trackedIssue  TrackedIssue?       @relation(fields: [trackedIssueId], references: [id], onDelete: SetNull)
  screenshot    Screenshot?         @relation(fields: [screenshotId], references: [id], onDelete: SetNull)
  accessibility AccessibilityIssue?
  uiHealth      UIHealthIssue?
  seo           SEOIssue?
  security      SecurityIssue?
  functional    FunctionalIssue?
  bugReports    BugReport[]
  aiInsights    AiInsight[]

  @@unique([scanId, fingerprint])
  @@index([scanId, category, severity])
  @@index([scanPageId])
  @@index([trackedIssueId])
}

model AccessibilityIssue {
  issueId        String        @id
  axeRuleId      String
  impact         String? // axe impact: critical | serious | moderate | minor
  wcagCriteria   String[]      @default([]) // e.g. ["1.1.1"]
  wcagLevel      String? // A | AA | AAA
  tags           String[]      @default([])
  helpUrl        String?
  detection      DetectionType @default(AUTOMATED)
  failureSummary String?

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([axeRuleId])
}

model UIHealthIssue {
  issueId      String      @id
  checkType    UiCheckType
  resourceUrl  String?
  statusCode   Int?
  measurements Json? // e.g. { scrollWidth: 1450, viewportWidth: 390 }

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([checkType])
}

model SEOIssue {
  issueId   String       @id
  checkType SeoCheckType
  expected  String?
  actual    String?

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([checkType])
}

/// Details of a FUNCTIONAL issue (Phase 9): which control was used and what happened.
model FunctionalIssue {
  issueId         String              @id
  checkType       FunctionalCheckType
  controlName     String?
  controlRole     String?
  controlSelector String?
  /// Steps, measurements and blocked actions recorded while interacting.
  interaction     Json?

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([checkType])
}

model SecurityIssue {
  issueId          String               @id
  checkType        SecurityCheckType
  findingLevel     SecurityFindingLevel @default(WARNING)
  headerName       String?
  observedValue    String?
  recommendedValue String?

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([checkType])
}

/// One problem across many scans of a website (same fingerprint).
/// Powers "new / resolved / recurring" and keeps user decisions such as
/// "ignore" or "false positive" from one scan to the next.
model TrackedIssue {
  id               String        @id @default(cuid())
  websiteId        String
  fingerprint      String
  category         IssueCategory
  ruleId           String
  title            String
  severity         Severity
  status           IssueStatus   @default(OPEN)
  occurrenceCount  Int           @default(1)
  firstSeenScanId  String?
  lastSeenScanId   String?
  resolvedInScanId String?
  firstSeenAt      DateTime      @default(now())
  lastSeenAt       DateTime      @default(now())
  resolvedAt       DateTime?
  reviewStatus     ReviewStatus  @default(UNREVIEWED)
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  website        Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  reviewedBy     User?         @relation("TrackedIssueReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviews        IssueReview[]
  firstSeenScan  Scan?         @relation("TrackedFirstSeen", fields: [firstSeenScanId], references: [id], onDelete: SetNull)
  lastSeenScan   Scan?         @relation("TrackedLastSeen", fields: [lastSeenScanId], references: [id], onDelete: SetNull)
  resolvedInScan Scan?         @relation("TrackedResolvedIn", fields: [resolvedInScanId], references: [id], onDelete: SetNull)
  issues         Issue[]

  @@unique([websiteId, fingerprint])
  @@index([websiteId, status])
  @@index([websiteId, firstSeenAt]) // dashboard: newly detected per day
  @@index([websiteId, resolvedAt]) // dashboard: resolved per day
}

/// Append-only history of human decisions on a tracked problem (Phase 9): review
/// verdicts and lifecycle changes made by people. Rows are never edited (a database
/// trigger refuses updates other than clearing userId when a user is deleted).
model IssueReview {
  id             String        @id @default(cuid())
  trackedIssueId String
  userId         String?
  fromStatus     IssueStatus?
  toStatus       IssueStatus?
  fromReview     ReviewStatus?
  toReview       ReviewStatus?
  note           String?
  createdAt      DateTime      @default(now())

  trackedIssue TrackedIssue @relation(fields: [trackedIssueId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([trackedIssueId, createdAt])
}

// ----------------------------------------------------------------------------
// Performance
// ----------------------------------------------------------------------------

model PerformanceResult {
  id                 String     @id @default(cuid())
  scanId             String
  scanPageId         String
  formFactor         FormFactor @default(MOBILE)
  performanceScore   Int?
  accessibilityScore Int?
  bestPracticesScore Int?
  seoScore           Int?
  fcpMs              Float?
  lcpMs              Float?
  cls                Float?
  inpMs              Float? // null in navigation mode; see docs/02-modules.md
  tbtMs              Float?
  speedIndexMs       Float?
  opportunities      Json? // render-blocking, unused CSS/JS, image size, ...
  diagnostics        Json?
  lighthouseVersion  String?
  rawReportKey       String? // full Lighthouse JSON in file storage
  createdAt          DateTime   @default(now())

  scan     Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanPage ScanPage @relation(fields: [scanPageId], references: [id], onDelete: Cascade)

  @@unique([scanPageId, formFactor])
  @@index([scanId])
}

// ----------------------------------------------------------------------------
// Screenshots & visual regression
// ----------------------------------------------------------------------------

/// Metadata only. The PNG lives in file storage under `storageKey`.
model Screenshot {
  id         String         @id @default(cuid())
  scanId     String? // null for baseline copies, so deleting old scans never deletes baselines
  scanPageId String?
  kind       ScreenshotKind
  viewport   String?
  width      Int
  height     Int
  storageKey String         @unique
  mimeType   String         @default("image/png")
  sizeBytes  Int
  createdAt  DateTime       @default(now())

  scan                 Scan?              @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanPage             ScanPage?          @relation(fields: [scanPageId], references: [id], onDelete: Cascade)
  issues               Issue[]
  bugReports           BugReport[]
  baseline             VisualBaseline?    @relation("BaselineScreenshot")
  comparisonsAsCurrent VisualComparison[] @relation("ComparisonCurrent")
  comparisonsAsDiff    VisualComparison[] @relation("ComparisonDiff")

  @@index([scanId])
  @@index([scanPageId])
}

model VisualBaseline {
  id            String   @id @default(cuid())
  websiteId     String
  pageUrl       String
  viewport      String
  screenshotId  String   @unique
  ignoreRegions Json     @default("[]") // [{ x, y, width, height }] or CSS selectors
  failPercent   Float    @default(0.5) // comparisons above this % are "changed"
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  website     Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  screenshot  Screenshot         @relation("BaselineScreenshot", fields: [screenshotId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  comparisons VisualComparison[]

  @@unique([websiteId, pageUrl, viewport])
}

model VisualComparison {
  id                  String                 @id @default(cuid())
  baselineId          String
  scanId              String?
  currentScreenshotId String
  diffScreenshotId    String?
  diffPixels          Int
  totalPixels         Int
  diffPercent         Float
  passed              Boolean
  /// UNCHANGED = identical; MINOR = small differences under the baseline's threshold;
  /// CHANGED = above the threshold (or the page size changed).
  status              VisualComparisonStatus @default(UNCHANGED)
  /// Changed regions (bounding boxes), size change and comparison settings.
  details             Json?
  createdAt           DateTime               @default(now())

  baseline          VisualBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  scan              Scan?          @relation(fields: [scanId], references: [id], onDelete: SetNull)
  currentScreenshot Screenshot     @relation("ComparisonCurrent", fields: [currentScreenshotId], references: [id], onDelete: Cascade)
  diffScreenshot    Screenshot?    @relation("ComparisonDiff", fields: [diffScreenshotId], references: [id], onDelete: SetNull)

  @@index([baselineId, createdAt(sort: Desc)])
}

// ----------------------------------------------------------------------------
// Bug reports, AI, notifications, audit log
// ----------------------------------------------------------------------------

/// Fields are copied from the issue at creation time, so the report stays
/// readable even after the original scan is deleted.
model BugReport {
  id               String          @id @default(cuid())
  projectId        String
  websiteId        String?
  issueId          String?
  createdById      String?
  title            String
  description      String
  severity         Severity
  priority         Priority        @default(P3)
  status           BugReportStatus @default(OPEN)
  affectedUrl      String
  browser          String
  viewport         String
  stepsToReproduce String[]        @default([])
  expectedBehavior String
  actualBehavior   String
  selector         String?
  htmlSnippet      String?
  suggestedFix     String?
  screenshotId     String?
  aiGenerated      Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  website    Website?    @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  issue      Issue?      @relation(fields: [issueId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  screenshot Screenshot? @relation(fields: [screenshotId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([issueId])
}

/// Cached Claude responses: one per issue and kind, so repeat views cost nothing.
model AiInsight {
  id            String        @id @default(cuid())
  issueId       String
  kind          AiInsightKind
  model         String
  /// Which prompt produced this answer; a new prompt version is asked again (Phase 9).
  promptVersion String        @default("issue-explain/v1")
  content       Json
  inputTokens   Int?
  outputTokens  Int?
  createdById   String?
  createdAt     DateTime      @default(now())

  issue     Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([issueId, kind])
}

model Notification {
  id          String                  @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  link        String?
  readAt      DateTime?
  /// The real email outcome. The UI only says "sent" when this is SENT.
  emailStatus NotificationEmailStatus @default(NOT_REQUESTED)
  emailedAt   DateTime?
  /// Short reason when sending failed (never contains credentials).
  emailError  String?
  /// e.g. { scanId, websiteId, newIssues, visualChanges }
  metadata    Json?
  createdAt   DateTime                @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
}

/// Append-only audit trail. Survives user/project deletion (SetNull).
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  projectId  String?
  action     String // e.g. "website.created", "scan.cancelled"
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}
