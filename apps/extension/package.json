{
  "name": "@whc/extension",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run build -w @whc/dom-checks",
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build -w @whc/dom-checks && node scripts/build.mjs && node scripts/build.mjs --test && node scripts/build.mjs --keyed",
    "test": "vitest run"
  },
  "dependencies": {
    "@whc/dom-checks": "*",
    "axe-core": "^4.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@whc/scanner": "*",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
