# =============================================================================
# Website Health Checker: environment variables
#
# 1. Copy this file:   Copy-Item .env.example .env     (PowerShell)
# 2. Change the values marked CHANGE-ME before using anything outside your PC.
# 3. NEVER commit .env. It is listed in .gitignore.
#
# Docker Compose also reads this .env file automatically (same folder as
# docker-compose.yml), so the database password is defined in ONE place.
# =============================================================================

# ---- General ----------------------------------------------------------------
NODE_ENV=development
# trace | debug | info | warn | error
LOG_LEVEL=info

# ---- PostgreSQL (used by the postgres container AND the apps) -----------------
POSTGRES_USER=whc
# CHANGE-ME for anything other than local development
POSTGRES_PASSWORD=whc_dev_password
POSTGRES_DB=whc
POSTGRES_PORT=5432

# Connection string used by apps running on your PC (npm run dev).
# Inside Docker, docker-compose.yml overrides it to use host "postgres".
DATABASE_URL=postgresql://whc:whc_dev_password@localhost:5432/whc?schema=public
# Separate database used only by automated tests (created automatically by
# docker/postgres/init/01-create-test-db.sql the first time Postgres starts).
DATABASE_URL_TEST=postgresql://whc:whc_dev_password@localhost:5432/whc_test?schema=public

# ---- Redis --------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- API ----------------------------------------------------------------------
API_PORT=4000
# Browser origins allowed to call the API (comma-separated). Vite dev server + Docker web.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ---- Web (Docker) -------------------------------------------------------------
# Port on your PC for the containerized frontend (8080 was already in use).
WEB_PORT=8081

# ---- Authentication ---------------------------------------------------------------
# Secret that signs login tokens (JWT). CHANGE-ME: the API refuses to start in
# production with this example value. Generate a random one in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Access token lifetime (s, m or h). Short on purpose; it is renewed automatically.
ACCESS_TOKEN_TTL=15m
# A login session ends this many days after sign-in (or earlier on logout).
REFRESH_TOKEN_TTL_DAYS=7
# false for local http://localhost; true in production (HTTPS only)
COOKIE_SECURE=false
# Where the web app runs (used in password-reset email links)
APP_URL=http://localhost:5173
# Limits on login/registration/reset attempts. Keep true.
RATE_LIMIT_ENABLED=true

# ---- Email (password reset) ---------------------------------------------------------
# Mailpit catches all emails in development. Read them at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Website Health Checker <no-reply@whc.local>"

# ---- Claude AI (used from Phase 6) -------------------------------------------------
# Leave empty to disable AI features; the rest of the app keeps working.
# Get a key at https://console.anthropic.com. NEVER put it in frontend code.
ANTHROPIC_API_KEY=
# Default: Claude Sonnet (good quality at lower cost). Change any time, e.g. claude-opus-5-5
CLAUDE_MODEL=claude-sonnet-5-5
# Cost controls: explanations per user per hour, per day for the whole system, answer length.
# Explanations are cached per problem, so rescans reuse them without a new AI call.
AI_USER_HOURLY_LIMIT=20
AI_DAILY_REQUEST_LIMIT=200
AI_MAX_OUTPUT_TOKENS=2500

# ---- File storage ------------------------------------------------------------------
# Screenshots. Relative paths are resolved from the repository root (API and scanner share it).
STORAGE_DIR=./storage

# ---- Egress proxy (SSRF protection) ---------------------------------------------------
# Every request the scanner makes goes through this proxy, which refuses private,
# loopback, link-local (cloud metadata) and other internal addresses.
PROXY_HOST=127.0.0.1
PROXY_PORT=3128
PROXY_ALLOWED_PORTS=80,443
# TEST ONLY ("name=ip,..."): lets automated tests reach local fixture sites. Refused in production.
PROXY_TEST_HOST_MAP=
# Where the scanner finds the proxy (use 127.0.0.1, not "localhost", on Windows)
EGRESS_PROXY_URL=http://127.0.0.1:3128

# ---- Scanner -------------------------------------------------------------------------
# Scans processed at the same time by one scanner process (each runs its own browser)
SCANNER_CONCURRENCY=1
SCAN_MAX_PAGES=100
SCAN_NAV_TIMEOUT_MS=30000
SCAN_MAX_DURATION_MS=900000
SCAN_MAX_LINK_CHECKS=150
SCAN_MAX_ISSUE_SCREENSHOTS=40
# Lighthouse performance audit (mobile lab test, ~10-30 s per page, run one page at a time).
# Pages per scan = the lower of this and the website's "Lighthouse pages" setting.
SCAN_LIGHTHOUSE_ENABLED=true
SCAN_MAX_LIGHTHOUSE_PAGES=3
SCAN_LIGHTHOUSE_TIMEOUT_MS=90000
# Visual regression: PNG snapshots (desktop + mobile) of this many pages per scan. 0 = off.
SCAN_VISUAL_PAGES=3
# Storage cleanup runs hourly. Files of deleted scans and unused baseline images are always
# removed. Set this above 0 to also delete page screenshots and raw Lighthouse files of scans
# older than N days (each website's latest scan, bug report screenshots and visual snapshots are kept).
SCAN_RETENTION_DAYS=0
# false = watch the browser work (local debugging only)
SCANNER_HEADLESS=true
# Optional: use an installed browser instead of Playwright's Chromium (e.g. msedge, chrome)
SCANNER_BROWSER_CHANNEL=
# Max scans one user can have queued/running at once
MAX_ACTIVE_SCANS_PER_USER=3
REQUIRE_DOMAIN_VERIFICATION=false
